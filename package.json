{
  "name": "blue-pixel-ai-chatbot",
  "version": "1.0.0",
  "description": "Blue Pixel AI Real Estate Chatbot with MCP integration",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "vercel-build": "cd client && npm install && npm run build",
    "test": "node test-chatbot.js"
  },
  "keywords": ["chatbot", "real-estate", "ai", "mcp", "react", "node"],
  "author": "Blue Pixel AI",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
