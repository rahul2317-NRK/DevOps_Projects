{
  "name": "blue-pixel-ai-chatbot-vercel",
  "version": "1.0.0",
  "description": "Blue Pixel AI Real Estate Chatbot - Vercel Serverless Deployment",
  "main": "api/vercel-compatible.js",
  "scripts": {
    "start": "node api/vercel-compatible.js",
    "build": "echo 'Building for Vercel...' && cd client && npm run build",
    "vercel-build": "cd client && npm install && npm run build",
    "dev": "node api/vercel-compatible.js",
    "test": "echo 'Testing API endpoints...'",
    "deploy": "vercel --prod"
  },
  "keywords": [
    "chatbot",
    "real-estate", 
    "ai",
    "vercel",
    "serverless",
    "rest-api",
    "no-websocket"
  ],
  "author": "Blue Pixel AI",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/blue-pixel-chatbot.git"
  },
  "vercel": {
    "functions": {
      "api/vercel-compatible.js": {
        "maxDuration": 30
      }
    }
  }
}